# Copy this file to .env and fill in your key:
#
#     cp .env.example .env
#
# .env is never committed and is read only by the backend. The key is never
# sent to the browser — the frontend calls our own API, and our API calls Gemini.

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which Gemini model to use for reading labels.
# Default is gemini-3.7-flash. If the free-tier daily quota runs out mid-demo,
# switch to a lighter model:
#   GEMINI_MODEL=gemini-3.5-flash-lite
#   GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-3.7-flash
